<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_association_event_tree" model="ir.ui.view">
        <field name="name">association.event.tree</field>
        <field name="model">association.event</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date"/>
                <field name="max_participants"/>
                <field name="participant_count"/>
                <field name="cost"/>
                <field name="revenue"/>
                <field name="profit"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_association_event_form" model="ir.ui.view">
        <field name="name">association.event.form</field>
        <field name="model">association.event</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirmer" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_done" string="Marquer comme Terminé" type="object" class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Annuler" type="object" invisible="state in ('cancelled', 'done')"/>
                    <button name="action_draft" string="Revenir à Brouillon" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="max_participants"/>
                        </group>
                        <group>
                            <field name="cost"/>
                            <field name="revenue"/>
                            <field name="profit"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Participants">
                            <field name="participant_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_association_events" model="ir.actions.act_window">
        <field name="name">Événements</field>
        <field name="res_model">association.event</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_association_events" name="Événements" parent="menu_association_root" action="action_association_events"/>
</odoo>