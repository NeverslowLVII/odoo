<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_association_event_tree" model="ir.ui.view">
        <field name="name">association.event.tree</field>
        <field name="model">association.event</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date"/>
                <field name="max_participants"/>
                <field name="participant_count"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_association_event_form" model="ir.ui.view">
        <field name="name">association.event.form</field>
        <field name="model">association.event</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_done" string="Mark as Done" type="object" invisible="state != 'confirmed'" class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_draft" string="Set to Draft" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Event Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="max_participants"/>
                        </group>
                        <group>
                            <field name="participant_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Participants">
                            <field name="participant_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_association_events" model="ir.actions.act_window">
        <field name="name">Events</field>
        <field name="res_model">association.event</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_association_events" name="Events" parent="menu_association_root" action="action_association_events"/>
</odoo>