<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Définition de la vue formulaire pour les reçus d'association -->
    <record id="view_association_receipt_form" model="ir.ui.view">
        <field name="name">association.receipt.form</field>
        <field name="model">association.receipt</field>
        <field name="arch" type="xml">
            <form>
                <!-- En-tête avec boutons d'action et barre de statut -->
                <header>
                    <button name="action_validate" string="Valider" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Annuler" type="object" invisible="state not in ('draft', 'validated')"/>
                    <button name="action_draft" string="Mettre en brouillon" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <!-- Titre du formulaire -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <!-- Groupes de champs -->
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="amount"/>
                            <field name="event_id"/>
                        </group>
                        <group>
                            <field name="image" widget="image"/>
                        </group>
                    </group>
                </sheet>
                <!-- Section de discussion (chatter) -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Définition de la vue liste pour les reçus d'association -->
    <record id="view_association_receipt_tree" model="ir.ui.view">
        <field name="name">association.receipt.tree</field>
        <field name="model">association.receipt</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date"/>
                <field name="amount"/>
                <field name="event_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Définition de l'action pour afficher les reçus -->
    <record id="action_association_receipts" model="ir.actions.act_window">
        <field name="name">Reçus</field>
        <field name="res_model">association.receipt</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Élément de menu pour accéder aux reçus -->
    <menuitem id="menu_association_receipts" name="Reçus" parent="menu_association_root" action="action_association_receipts" sequence="30"/>

    <!-- Définition de la vue formulaire pour le wizard de scan de reçu -->
    <record id="view_receipt_scan_wizard_form" model="ir.ui.view">
        <field name="name">association.receipt.scan.wizard.form</field>
        <field name="model">association.receipt.scan.wizard</field>
        <field name="arch" type="xml">
            <form string="Scanner un reçu">
                <group>
                    <field name="scanned_image" widget="image"/>
                </group>
                <footer>
                    <button name="action_attach_image" string="Attacher" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>